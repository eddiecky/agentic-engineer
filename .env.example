# JIRA
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=your_token

# GitHub
GITHUB_TOKEN=ghp_xxx

# Copilot SDK
COPILOT_MODEL=gpt-5
COPILOT_MODE=empty
COPILOT_BASE_DIRECTORY=.copilot

# BYOK Provider (optional — uses GitHub Copilot auth when omitted)
# Use "openai" type for OpenAI-compatible providers (OpenRouter, Ollama, etc.)
COPILOT_PROVIDER_TYPE=openai
COPILOT_PROVIDER_BASE_URL=https://api.openai.com/v1
# COPILOT_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
COPILOT_PROVIDER_API_KEY=sk-xxx
# COPILOT_PROVIDER_BEARER_TOKEN=xxx

# App
PORT=3000
LOG_LEVEL=info
REPO_BASE_PATH=/tmp/agentic-engineer/repos


